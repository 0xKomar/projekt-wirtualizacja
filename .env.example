# Configuration template. Copy it and fill in the values:  cp .env.example .env
# .env is ignored by git, so real passwords never reach the repository.

# Database (db container, official postgres image)
POSTGRES_DB=iot_noise
POSTGRES_USER=iot
POSTGRES_PASSWORD=change_me

# Backend
# "db" is the service name in docker-compose.yml
DB_HOST=db
DB_PORT=5432
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=8080
# Where nginx and the simulator reach the backend (inside the compose network)
BACKEND_URL=http://backend:8000

# Simulator (docker compose --profile sim up): seconds between readings
SIM_INTERVAL=10
